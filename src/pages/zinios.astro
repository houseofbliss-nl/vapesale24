---
import Base from "../layouts/Base.astro";
import { SITE_NAME } from "../lib/site";
import { POSTS } from "../lib/blog";
---
<Base title={`Žinios — ${SITE_NAME}`} canonicalPath="/zinios">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-black text-neutral-900 md:text-5xl">Žinios</h1>
    <p class="mt-4 text-neutral-600">
      Naudingi straipsniai apie vapingą, nikotino pagalvėles ir e-skysčius — kad išsirinkti
      būtų lengviau. Nauji įrašai reguliariai.
    </p>
    <div class="mt-8 space-y-4">
      {POSTS.map((p) => (
        <a
          href={`/zinios/${p.slug}`}
          class="block rounded-lg border border-neutral-200 p-4 hover:border-[#7C3AED] hover:bg-[#FAF8FF] transition-colors"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">{p.date}</p>
          <p class="mt-1 font-bold text-neutral-900">{p.title}</p>
          <p class="mt-1 text-sm text-neutral-600">{p.excerpt}</p>
        </a>
      ))}
    </div>
  </div>
</Base>